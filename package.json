{
  "name": "dsh-knowledge-manager",
  "version": "0.2.53",
  "private": true,
  "type": "module",
  "description": "DSH knowledge manager: SQLite local knowledge base with optional MariaDB/MySQL external libraries.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "locale/*.json",
    "docs",
    "icon.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  },
  "license": "MIT",
  "author": "1024",
  "homepage": "https://space.bilibili.com/41158746",
  "repository": {
    "type": "git",
    "url": "https://github.com/MEMUZE80020/dsh-knowledge-manager"
  },
  "bugs": {
    "url": "https://space.bilibili.com/41158746"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "knowledge-base",
    "sqlite"
  ]
}